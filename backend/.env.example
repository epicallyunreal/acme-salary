# Copy to backend/.env for local runs. .env is never committed.
# Local: `uv run --env-file .env python manage.py runserver`. Docker: compose reads this file.
SECRET_KEY=replace-with-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
DATABASE_PATH=db.sqlite3
SEED_ADMIN_PASSWORD=change-me
# Container only. Leave unset locally so Vite serves the app.
# SPA_DIR=/app/spa
