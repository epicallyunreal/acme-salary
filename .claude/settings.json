{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(uv *)",
      "Bash(pytest)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(ruff *)",
      "Bash(django-admin *)",
      "Bash(python manage.py migrate *)",
      "Bash(python manage.py migrate)",
      "Bash(python manage.py makemigrations *)",
      "Bash(python manage.py makemigrations)",
      "Bash(python manage.py check)",
      "Bash(python manage.py collectstatic *)",
      "Bash(python manage.py seed_data *)",
      "Bash(python manage.py make_import_file *)",
      "Bash(python manage.py reset_demo *)",
      "Bash(python manage.py set_exchange_rate *)",
      "Bash(python manage.py timing)",
      "Bash(python manage.py runserver *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm ci)",
      "Bash(npm create *)",
      "Bash(npx prettier *)",
      "Bash(npx eslint *)",
      "Bash(npx vitest *)",
      "Bash(docker build *)",
      "Bash(docker compose *)",
      "Bash(fly status *)",
      "Bash(fly logs *)",
      "Bash(flyctl status *)",
      "Bash(flyctl logs *)"
    ],
    "ask": [
      "Edit(/docs/SPEC.md)",
      "Edit(/docs/REQUIREMENTS.md)",
      "Edit(/docs/PLAN.md)",
      "Edit(/docs/DESIGN.md)",
      "Edit(/docs/reviews/**)",
      "Bash(git push *)",
      "Bash(fly deploy *)",
      "Bash(flyctl deploy *)",
      "Bash(fly *)",
      "Bash(flyctl *)",
      "Bash(curl *)",
      "Bash(pip install *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(python manage.py *)"
    ],
    "deny": [
      "Read(/.env)",
      "Read(/backend/.env)",
      "Read(/frontend/.env)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session_start.py",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/git_guard.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre_commit_gate.py",
            "timeout": 900
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/dependency_note.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post_edit.py",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
