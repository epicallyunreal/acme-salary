{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(uv sync)",
      "Bash(uv sync *)",
      "Bash(uv venv)",
      "Bash(uv venv *)",
      "Bash(uv lock)",
      "Bash(uv lock *)",
      "Bash(uv run *)",
      "Bash(pytest)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(ruff *)",
      "Bash(django-admin startproject *)",
      "Bash(django-admin startapp *)",
      "Bash(python manage.py check)",
      "Bash(python manage.py check *)",
      "Bash(python manage.py makemigrations)",
      "Bash(python manage.py makemigrations *)",
      "Bash(python manage.py migrate)",
      "Bash(python manage.py migrate *)",
      "Bash(python manage.py showmigrations *)",
      "Bash(python manage.py seed_data --employees *)",
      "Bash(python manage.py make_import_file *)",
      "Bash(python manage.py set_exchange_rate *)",
      "Bash(python manage.py timing)",
      "Bash(python manage.py runserver *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm ci)",
      "Bash(npm create *)",
      "Bash(npx prettier *)",
      "Bash(npx eslint *)",
      "Bash(npx vitest *)",
      "Bash(docker build *)",
      "Bash(docker compose build *)",
      "Bash(docker compose up *)",
      "Bash(docker compose down)",
      "Bash(docker compose logs *)",
      "Bash(fly status *)",
      "Bash(fly logs *)",
      "Bash(fly certs check *)",
      "Bash(flyctl status *)",
      "Bash(flyctl logs *)"
    ],
    "ask": [
      "Edit(/docs/SPEC.md)",
      "Edit(/docs/REQUIREMENTS.md)",
      "Edit(/docs/PLAN.md)",
      "Edit(/docs/DESIGN.md)",
      "Edit(/docs/reviews/**)",
      "Bash(git push *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(uv pip *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(python manage.py shell *)",
      "Bash(python manage.py shell)",
      "Bash(python manage.py dbshell *)",
      "Bash(python manage.py dbshell)",
      "Bash(python manage.py flush *)",
      "Bash(python manage.py flush)",
      "Bash(python manage.py sqlflush *)",
      "Bash(python manage.py seed_data *--reset*)",
      "Bash(python manage.py reset_demo *)",
      "Bash(python manage.py reset_demo)",
      "Bash(fly deploy *)",
      "Bash(fly deploy)",
      "Bash(fly volumes *)",
      "Bash(fly machine *)",
      "Bash(fly machines *)",
      "Bash(fly secrets *)",
      "Bash(fly scale *)",
      "Bash(fly apps *)",
      "Bash(fly ssh *)",
      "Bash(flyctl deploy *)",
      "Bash(flyctl deploy)",
      "Bash(flyctl volumes *)",
      "Bash(flyctl machine *)",
      "Bash(flyctl secrets *)",
      "Bash(docker compose down *)",
      "Bash(docker rm *)",
      "Bash(docker rmi *)",
      "Bash(docker volume *)",
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "deny": [
      "Read(/.env)",
      "Read(/backend/.env)",
      "Read(/frontend/.env)",
      "Bash(rm -rf *)",
      "Bash(sudo *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session_start.py",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/git_guard.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre_commit_gate.py",
            "timeout": 900
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/dependency_note.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post_edit.py",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
